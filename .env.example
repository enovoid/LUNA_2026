# 실제 값은 커밋하지 마세요. 로컬은 .env, 운영은 Railway·GitHub Secrets에 둡니다.

# Notion (읽기 권한 integration, 4개 DB에만 공유)
NOTION_TOKEN=
NOTION_DB_MEMBERS=
NOTION_DB_AWARDS=
NOTION_DB_PROJECTS=
NOTION_DB_FAQ=

# Railway Postgres
DATABASE_URL=postgres://user:password@localhost:5432/luna

# Cloudflare R2 (S3 호환)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://images.example.com

# GitHub repository_dispatch 전용 fine-grained token (이 저장소 dispatch 권한만)
GITHUB_DISPATCH_TOKEN=
# (선택) dispatch 대상 저장소. 기본 enovoid/LUNA_2026
# GITHUB_DISPATCH_REPOSITORY=

# (선택) 동기화: 쓰이지 않게 된 R2 이미지를 지우기 전 유예 시간(분). 기본 120
# SYNC_ORPHAN_GRACE_MINUTES=120

# Cloudflare 배포 (GitHub Actions)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
