{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // 정적 사이트를 Cloudflare Workers Static Assets로 배포한다.
  // Cloudflare·Astro 문서 모두 새 프로젝트에는 Pages 대신 Workers를 권장한다. 정적 사이트라 main(Worker 코드)과 어댑터는 필요 없다.
  "name": "luna-2026",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // 없는 주소는 dist/404.html을 404 상태로 돌려준다.
    "not_found_handling": "404-page",
    // build.format: 'file' → /members 가 dist/members.html 로 연결된다.
    "html_handling": "drop-trailing-slash"
  }
}
