{
  // Cloudflare Workers Static Assets로 dist를 배포한다.
  // TODO: Cloudflare 문서에서 현재 권장 방식(Workers Static Assets vs Pages)을 확인하고 name·도메인을 확정
  "name": "luna-2026",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // 없는 주소는 dist/404.html을 404 상태로 돌려준다.
    "not_found_handling": "404-page",
    // build.format: 'file' → /members 가 dist/members.html 로 연결된다.
    "html_handling": "drop-trailing-slash"
  }
}
