---
// 멤버 소개 시트(<dialog>). 모바일은 아래에서 올라오는 시트, 넓은 화면은 가운데 폼 시트(HIG).
// id가 멤버 앵커(member-…)라서 /members#member-… 로 들어오면 scripts/member-sheet.ts가 이 시트를 연다.
import { memberAnchor } from '../lib/content';
import type { Member } from '../lib/data';
import Picture from './Picture.astro';

interface Props {
  member: Member;
}
const { member } = Astro.props;
const anchor = memberAnchor(member);
const titleId = `${anchor}-name`;
const meta = [member.lunaGeneration, member.schoolGeneration, member.className]
  .filter(Boolean)
  .join(' · ');
const initial = member.name.slice(0, 1);
---

<dialog class="sheet" id={anchor} aria-labelledby={titleId} data-member-sheet>
  <div class="sheet-body">
    <span class="sheet-grabber" aria-hidden="true"></span>
    <form method="dialog" class="sheet-close-form">
      <button class="sheet-close pressable" aria-label="닫기">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M2 2l10 10M12 2L2 12"></path>
        </svg>
      </button>
    </form>
    <Picture image={member.image} alt={`${member.name} 프로필 사진`} ratio="1 / 1" sizes="200px" class="sheet-photo">
      <span class="member-initial" aria-hidden="true">{initial}</span>
    </Picture>
    <div class="sheet-head">
      <h3 id={titleId}>{member.name}</h3>
      {member.position && <span class="chip chip-brand">{member.position}</span>}
    </div>
    {meta && <p class="sheet-meta">{meta}</p>}
    {member.description && <p class="sheet-desc">{member.description}</p>}
  </div>
</dialog>

<style>
  .member-initial {
    font-size: 56px;
    font-weight: 700;
    color: var(--accent, var(--color-accent));
  }
  .sheet {
    position: fixed;
    inset: auto 0 0;
    width: 100%;
    max-width: none;
    max-height: 88dvh;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: var(--sheet-top-radius) var(--sheet-top-radius) 0 0;
    background: var(--surface-1, var(--color-card));
    color: var(--text, var(--color-label));
    overflow: auto;
    overscroll-behavior: contain;
    opacity: 0;
    transition:
      opacity var(--fade-dur) ease,
      overlay var(--spring-smooth-dur) allow-discrete,
      display var(--spring-smooth-dur) allow-discrete;
  }
  .sheet[open] {
    opacity: 1;
  }
  @starting-style {
    .sheet[open] {
      opacity: 0;
    }
  }
  .sheet::backdrop {
    background: rgb(14 13 20 / 0.6);
    opacity: 0;
    transition:
      opacity var(--fade-dur) ease,
      overlay var(--spring-smooth-dur) allow-discrete,
      display var(--spring-smooth-dur) allow-discrete;
  }
  .sheet[open]::backdrop {
    opacity: 1;
  }
  @starting-style {
    .sheet[open]::backdrop {
      opacity: 0;
    }
  }
  /* 움직임은 transform만. 동작 줄이기에서는 위 크로스페이드만 남는다. */
  @media (prefers-reduced-motion: no-preference) {
    .sheet {
      opacity: 1;
      transform: translate3d(0, 100%, 0);
      transition:
        transform var(--spring-smooth-dur) var(--spring-smooth),
        overlay var(--spring-smooth-dur) allow-discrete,
        display var(--spring-smooth-dur) allow-discrete;
    }
    .sheet[open] {
      transform: none;
    }
    @starting-style {
      .sheet[open] {
        opacity: 1;
        transform: translate3d(0, 100%, 0);
      }
    }
  }
  .sheet-body {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 12px 24px calc(32px + env(safe-area-inset-bottom));
    text-align: center;
  }
  .sheet-grabber {
    width: 36px;
    height: 5px;
    margin-bottom: 12px;
    border-radius: 3px;
    background: var(--color-fill-3);
  }
  .sheet-close-form {
    position: absolute;
    top: 14px;
    right: 14px;
    margin: 0;
  }
  .sheet-close {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.12);
    color: var(--text-2, var(--color-label-2));
    cursor: pointer;
  }
  .sheet-body :global(.sheet-photo) {
    width: min(200px, 56vw);
    margin-bottom: 8px;
    border-radius: 50%;
    background: var(--surface-2, var(--color-card-2));
  }
  .sheet-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 6px 10px;
  }
  .sheet-head h3 {
    margin: 0;
    font-size: 28px;
    line-height: 34px;
    font-weight: 700;
  }
  .sheet-meta {
    margin: 0;
    font-size: 15px;
    line-height: 20px;
    color: var(--text-2, var(--color-label-2));
  }
  .sheet-desc {
    max-width: 36em;
    margin: 12px 0 0;
    font-size: 17px;
    line-height: 26px;
    text-align: left;
    white-space: pre-line;
  }
  .chip-brand {
    background: var(--accent-soft, var(--color-lavender-tint));
    color: var(--accent, var(--color-accent));
  }

  @media (min-width: 768px) {
    .sheet {
      inset: 0;
      width: min(480px, calc(100% - 40px));
      max-height: 85dvh;
      margin: auto;
      border-radius: var(--radius-glass-medium);
    }
    .sheet-grabber {
      visibility: hidden;
    }
    .sheet-body {
      padding-bottom: 32px;
    }
  }
  @media (min-width: 768px) and (prefers-reduced-motion: no-preference) {
    .sheet {
      opacity: 0;
      transform: translate3d(0, 24px, 0) scale(0.96);
      transition:
        opacity var(--fade-dur) ease,
        transform var(--spring-smooth-dur) var(--spring-smooth),
        overlay var(--spring-smooth-dur) allow-discrete,
        display var(--spring-smooth-dur) allow-discrete;
    }
    .sheet[open] {
      opacity: 1;
      transform: none;
    }
    @starting-style {
      .sheet[open] {
        opacity: 0;
        transform: translate3d(0, 24px, 0) scale(0.96);
      }
    }
  }
</style>
