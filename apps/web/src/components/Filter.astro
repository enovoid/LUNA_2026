---
// 필터 컨트롤(세그먼트). 마크업은 정적으로 그리고, 동작은 scripts/segmented.ts가 붙인다(React 없이 약 1KB).
// 첫 페인트 전 URL 쿼리 적용은 목록 뒤의 FilterBoot가 맡는다(선택 표시도 같이 맞춘다).
import { ALL } from '../lib/filter-dom';

interface Props {
  label: string;
  param: string;
  options: string[];
  unit: string;
}
const { label, param, options, unit } = Astro.props;
const all = [ALL, ...options];
---

{
  options.length > 1 && (
    <div class="segmented-wrap" data-segmented data-param={param} data-unit={unit}>
      <div role="radiogroup" aria-label={label} class="segmented">
        <span class="segment-thumb" aria-hidden="true" />
        {all.map((option, i) => (
          <button type="button" role="radio" class="segment" value={option} aria-checked={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
            {option}
          </button>
        ))}
      </div>
      <p class="sr-only" aria-live="polite" />
    </div>
  )
}

<script>
  import "../scripts/segmented";
</script>

<style is:global>
  .segmented-wrap {
    max-width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
    border-radius: 1000px;
  }
  .segmented-wrap::-webkit-scrollbar {
    display: none;
  }
  .segmented {
    position: relative;
    display: inline-flex;
    gap: 4px;
    padding: 2px;
    border-radius: 1000px;
    background: var(--color-fill-3);
    white-space: nowrap;
  }
  .segment {
    min-width: 64px;
    height: 32px;
    padding: 0 14px;
    border: 0;
    border-radius: 1000px;
    background: transparent;
    color: var(--color-label);
    font: inherit;
    font-size: 13.33px;
    line-height: 18px;
    font-weight: 500;
    cursor: pointer;
    transition: background-color var(--fade-dur) ease;
  }
  .segment-thumb {
    position: absolute;
    top: 2px;
    bottom: 2px;
    left: 0;
    border-radius: 1000px;
    background: var(--misc-segmented-control-selected-fill);
    box-shadow: var(--shadow-segment-selected);
    opacity: 0;
    pointer-events: none;
  }
  .segment {
    position: relative;
  }
  .has-thumb .segment-thumb {
    opacity: 1;
    transition:
      transform var(--spring-snappy-dur) var(--spring-snappy),
      width var(--spring-snappy-dur) var(--spring-snappy);
  }
  .has-thumb .segment[aria-checked='true'] {
    background: transparent;
    box-shadow: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .has-thumb .segment-thumb {
      transition: none;
    }
  }
  .segment[aria-checked='true'] {
    background: var(--misc-segmented-control-selected-fill);
    box-shadow: var(--shadow-segment-selected);
    font-weight: 600;
    color: var(--color-label);
  }
  .segment:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }
</style>
