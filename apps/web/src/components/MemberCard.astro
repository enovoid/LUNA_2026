---
// 멤버 타일: 사진·이름·한 줄 정보만 둔다. 누르면 같은 앵커의 시트(MemberSheet)가 열린다.
// 테두리 없이 면 색과 빛으로만 구분한다. 다크 토큰(--surface-1 등)이 아직 없는 페이지에서도 보이도록 기존 토큰을 대체값으로 둔다.
import { memberAnchor } from '../lib/content';
import type { Member } from '../lib/data';
import Picture from './Picture.astro';

interface Props {
  member: Member;
}
const { member } = Astro.props;
const anchor = memberAnchor(member);
---

<button type="button" class="member pressable" aria-haspopup="dialog" aria-controls={anchor} data-member-open={anchor}>
  <Picture image={member.image} alt="" ratio="1 / 1" sizes="(min-width: 768px) 160px, calc(33vw - 24px)" class="member-photo">
    <span class="member-initial" aria-hidden="true">{member.name.slice(0, 1)}</span>
  </Picture>
  <span class="member-text">
    <span class="member-name">{member.name}</span>
    {member.position && <span class="member-position">{member.position}</span>}
  </span>
</button>

<style>
  .member {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    width: 100%;
    padding: 12px 4px 14px;
    border: 0;
    border-radius: var(--radius-card);
    background: none;
    color: inherit;
    font: inherit;
    text-align: center;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .member :global(.member-photo) {
    width: 100%;
    margin-bottom: 8px;
    border-radius: 50%;
    background: var(--surface-1, var(--color-card));
    transition: transform var(--spring-snappy-dur) var(--spring-snappy);
  }
  /* 달빛 번짐: 사진 뒤에 미리 그려 둔 라벤더 빛을 opacity·scale로만 띄운다(레이아웃 변화 없음). */
  .member {
    position: relative;
    isolation: isolate;
  }
  .member::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 0;
    z-index: -1;
    width: 120%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(144 127 223 / 0.32), rgb(144 127 223 / 0) 100%);
    opacity: 0;
    transform: translate3d(-50%, -4%, 0) scale(0.8);
    transition:
      opacity var(--fade-dur) ease,
      transform var(--spring-snappy-dur) var(--spring-snappy);
    pointer-events: none;
  }
  .member:focus-visible::before {
    opacity: 1;
    transform: translate3d(-50%, -4%, 0);
  }
  @media (hover: hover) {
    .member:hover::before {
      opacity: 1;
      transform: translate3d(-50%, -4%, 0);
    }
    .member:hover :global(.member-photo) {
      transform: scale(1.03);
    }
  }
  .member:focus-visible {
    outline: 2px solid var(--accent, var(--color-accent));
    outline-offset: 2px;
  }
  .member-initial {
    font-size: 32px;
    font-weight: 700;
    color: var(--accent, var(--color-accent));
  }
  /* 글자 칸은 내용과 상관없이 높이를 미리 잡아 둔다(이름 두 줄 + 정보 한 줄). 넘치면 말줄임.
     이름이 길거나 정보가 비어도 타일 높이가 모두 같고, 남는 자리는 아래로 간다. */
  .member-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    width: 100%;
    min-height: 64px;
  }
  .member-name {
    display: -webkit-box;
    width: 100%;
    font-size: 17px;
    line-height: 22px;
    font-weight: 600;
    overflow: hidden;
    overflow-wrap: anywhere;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }
  .member-position {
    width: 100%;
    font-size: 13px;
    line-height: 18px;
    color: var(--text-2, var(--color-label-2));
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

</style>
