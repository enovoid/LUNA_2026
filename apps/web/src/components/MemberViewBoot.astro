---
// 멤버 목록 뒤에 둔다. 첫 페인트 전에 ?view=position 이면 직군별 보기로 바꿔 둔다(레이아웃이 흔들리지 않게).
// 규칙은 MemberViewToggle의 show()와 같다.
---

<script is:inline>
  (() => {
    if (new URLSearchParams(location.search).get("view") !== "position") return;
    for (const el of document.querySelectorAll("[data-member-view]"))
      el.hidden = el.dataset.memberView !== "position";
    for (const b of document.querySelectorAll("[data-view-toggle] [data-view]")) {
      const on = b.dataset.view === "position";
      b.setAttribute("aria-checked", String(on));
      b.tabIndex = on ? 0 : -1;
    }
  })();
</script>
