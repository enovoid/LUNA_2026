---
// 좁은 화면 하단에 떠 있는 탭 바(디자인 시스템 TabBar bottom). 홈 인트로 동안에도 보인다.
import type { NavKey } from '../content/site';

interface Props {
  current: NavKey | null;
}
const { current } = Astro.props;

// 아이콘은 채운 모양(HIG Tab bars: 탭 바에는 채운 심볼을 쓴다). cut은 채운 면에서 뚫어 낼 선(FAQ의 물음표).
const tabs = [
  {
    key: 'home',
    label: '홈',
    href: '/',
    d: 'M9.4 2.9a.9.9 0 0 1 1.2 0l6.7 5.8c.6.5.2 1.5-.6 1.5h-.7v6.2a.9.9 0 0 1-.9.9h-3.3v-4.6H8.2v4.6H4.9a.9.9 0 0 1-.9-.9v-6.2h-.7c-.8 0-1.2-1-.6-1.5z',
  },
  {
    key: 'members',
    label: '멤버',
    href: '/members',
    d: 'M10 9.9a3.7 3.7 0 1 0 0-7.4 3.7 3.7 0 0 0 0 7.4zM2.8 16.8c0-3.3 3.2-5.5 7.2-5.5s7.2 2.2 7.2 5.5c0 .5-.4.9-.9.9H3.7a.9.9 0 0 1-.9-.9z',
  },
  {
    key: 'projects',
    label: '프로젝트',
    href: '/projects',
    d: 'M2 5.3c0-.8.6-1.4 1.4-1.4h4.1c.4 0 .8.2 1 .5l1.3 1.6h6.8c.8 0 1.4.6 1.4 1.4v8.3c0 .8-.6 1.4-1.4 1.4H3.4c-.8 0-1.4-.6-1.4-1.4z',
  },
  {
    key: 'awards',
    label: '수상',
    href: '/awards',
    d: 'M10 2.2a5.2 5.2 0 1 0 0 10.4 5.2 5.2 0 0 0 0-10.4zM6.4 13.1l-.9 4.4c-.1.6.5 1 1 .7l3.5-1.8 3.5 1.8c.5.3 1.1-.1 1-.7l-.9-4.4a6.7 6.7 0 0 1-7.2 0z',
  },
  {
    key: 'faq',
    label: 'FAQ',
    href: '/faq',
    d: 'M10 1.8a8.2 8.2 0 1 0 0 16.4 8.2 8.2 0 0 0 0-16.4z',
    cut: 'M7.8 7.7a2.3 2.3 0 0 1 4.4.9c0 1.5-2.2 2-2.2 3.3M10 14.4v.1',
  },
] as const;
---

<nav class="tab-bar" aria-label="주 메뉴">
  <ul class="glass">
    {
      tabs.map((tab) => (
        <li>
          <a href={tab.href} aria-current={tab.key === current ? "page" : undefined}>
            <svg viewBox="0 0 20 20" width="24" height="24" fill="currentColor" aria-hidden="true">
              {"cut" in tab ? (
                <>
                  <mask id={`tab-cut-${tab.key}`}>
                    <rect width="20" height="20" fill="#fff" />
                    <path d={tab.cut} fill="none" stroke="#000" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
                  </mask>
                  <path d={tab.d} mask={`url(#tab-cut-${tab.key})`} />
                </>
              ) : (
                <path d={tab.d} />
              )}
            </svg>
            <span>{tab.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .tab-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: max(12px, env(safe-area-inset-bottom));
    z-index: 40;
    display: flex;
    justify-content: center;
    /* 가로 모드의 노치·접이식 힌지 쪽 안전 영역을 피한다 */
    padding-inline: max(16px, env(safe-area-inset-left)) max(16px, env(safe-area-inset-right));
    pointer-events: none;
  }
  /* 탭 바 조금 위부터 화면 아래 끝까지 흐림 + 바탕색으로 서서히 덮어, 스크롤되는 글자가 탭 바와 겹쳐 보이지 않게 한다.
     요소 자신이 아닌 형제 층이라 탭 알약의 흐림(backdrop root)에 영향이 없고, 고정 위치라 레이아웃도 안 바뀐다. */
  .tab-bar::before {
    content: "";
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: -1;
    height: calc(max(12px, env(safe-area-inset-bottom)) + 62px + 32px);
    background: linear-gradient(to top, rgb(28 28 30 / 0.9) 35%, rgb(28 28 30 / 0));
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    -webkit-mask-image: linear-gradient(to top, #000 55%, transparent);
    mask-image: linear-gradient(to top, #000 55%, transparent);
  }
  @media (prefers-reduced-transparency: reduce) {
    .tab-bar::before {
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }
  ul {
    display: flex;
    width: 100%;
    max-width: 420px;
    height: 62px;
    margin: 0;
    padding: 4px;
    list-style: none;
    border-radius: 1000px;
    pointer-events: auto;
    /* 페이지 이동 때 제자리에 둔다. 이름은 흐림이 걸린 요소 자신에 둔다: 조상에 두면 그 조상이
       backdrop root가 되어 흐림이 아무것도 못 본다(Chromium). */
    view-transition-name: tab-bar;
  }
  li {
    flex: 1;
    min-width: 0;
  }
  a {
    display: flex;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1px;
    border-radius: 1000px;
    color: inherit;
    /* 디자인 시스템 caption-2-emphasized(11/13, 600) */
    font-size: 11px;
    line-height: 13px;
    font-weight: 600;
    text-decoration: none;
  }
  a {
    transition:
      background-color var(--fade-dur) ease,
      transform var(--spring-snappy-dur) var(--spring-snappy);
  }
  a[aria-current="page"] {
    color: var(--accent-on-soft);
    background: var(--accent-soft);
  }
  @media (prefers-reduced-motion: no-preference) {
    a:active {
      transform: scale(0.94);
      transition-duration: var(--press-dur);
      transition-timing-function: ease-out;
    }
  }
  /* 접이식 바깥 화면처럼 아주 좁을 때(≤ 359px)도 다섯 칸이 한 줄에 들어가게 */
  @media (max-width: 359px) {
    .tab-bar {
      padding-inline: 8px;
    }
    ul {
      padding: 3px;
    }
    /* 글자는 줄이지 않는다: 디자인 시스템 caption-2(11px)가 가장 작은 글자이고 HIG 최소 크기도 11pt다 */
    a {
      white-space: nowrap;
    }
  }
  @media (min-width: 768px) {
    .tab-bar {
      display: none;
    }
  }
</style>
