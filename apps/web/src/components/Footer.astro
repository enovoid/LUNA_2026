---
import { site } from '../content/site';
import { loadSiteData } from '../lib/data';
import Logo from './Logo.astro';

interface Props {
  dataSource: 'db' | 'mock';
}
const { dataSource } = Astro.props;
const { contact } = (await loadSiteData()).settings;
const links: { label: string; href: string }[] = [];
if (contact.email) links.push({ label: '이메일', href: `mailto:${contact.email}` });
if (contact.instagram) links.push({ label: 'Instagram', href: contact.instagram });
if (contact.github) links.push({ label: 'GitHub', href: contact.github });
---

<footer class="site-footer">
  <!-- 예전 luna-landing 푸터의 서명. 동아리 슬로건으로 페이지를 맺는다. -->
  <div class="container-page footer-sign">
    <Logo size={44} />
    <p class="footer-slogan">
      <span>세상을 비추는 달,</span>
      <strong>LUNA</strong>
    </p>
  </div>
  <div class="container-page footer-inner">
    <span class="footer-brand">
      LUNA · IT Social Venture{site.foundedYear && ` · Since ${site.foundedYear}`}
    </span>
    {
      links.length > 0 && (
        <ul class="footer-links">
          {links.map((l) => (
            <li>
              <a href={l.href} rel="noopener" class="tap">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }
    {site.photoCredit && <small class="footer-credit">인트로 사진: {site.photoCredit}</small>}
    {dataSource === "mock" && <small class="footer-mock">목업 데이터로 빌드한 화면입니다(배포용 아님).</small>}
  </div>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 56px 0 calc(108px + env(safe-area-inset-bottom));
    background: var(--color-card);
    font-size: 13px;
    line-height: 18px;
    color: var(--color-label-2);
  }
  @media (min-width: 768px) {
    .site-footer {
      padding-bottom: 48px;
    }
  }
  .footer-sign {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .footer-slogan {
    display: flex;
    flex-direction: column;
    margin: 0;
    color: var(--color-label-2);
    font-size: 15px;
    line-height: 20px;
    font-weight: 600;
  }
  .footer-slogan strong {
    color: var(--color-label);
    font-size: 28px;
    line-height: 32px;
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .footer-links {
    display: flex;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer-links a {
    color: inherit;
    font-weight: 600;
  }
  .footer-credit,
  .footer-mock {
    flex-basis: 100%;
    font-size: 12px;
  }
  .footer-mock {
    color: #ff8a80;
  }
</style>
