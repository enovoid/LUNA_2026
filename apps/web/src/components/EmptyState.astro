---
// 빈 상태(디자인 시스템 EmptyState). 데이터가 없거나 필터 결과가 없을 때.
interface Props {
  title: string;
  message?: string;
  /** 필터 결과용: 처음에는 숨겨 두고 필터 스크립트가 보인다 */
  filterEmpty?: boolean;
  class?: string;
}
const { title, message, filterEmpty = false, class: className } = Astro.props;
---

<div class:list={["empty", className]} data-filter-empty={filterEmpty ? "" : undefined} hidden={filterEmpty} role="status">
  <svg width="40" height="40" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M14.5 3.6A7 7 0 1 0 16.4 12a5 5 0 0 1-1.9-8.4z"></path>
  </svg>
  <p class="empty-title">{title}</p>
  {message && <p class="empty-message">{message}</p>}
  <slot />
</div>

<style>
  .empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 48px 24px;
    border-radius: 26px;
    background: var(--color-card);
    text-align: center;
    color: var(--color-label-2);
  }
  .empty svg {
    color: var(--color-brand-lavender);
  }
  .empty-title {
    margin: 4px 0 0;
    font-size: 17px;
    line-height: 22px;
    font-weight: 600;
    color: var(--color-label);
  }
  .empty-message {
    margin: 0;
    font-size: 15px;
    line-height: 20px;
  }
</style>
