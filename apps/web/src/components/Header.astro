---
// 상단 내비. 홈에서는 인트로 위에 투명하게 겹치고(fixed), 다른 페이지에서는 유리 막대(sticky)다.
// 인트로처럼 배경이 꽉 찬 구역(data-header-clear) 위에서는 막대 없이 투명하고, 그 밖에서는 유리 막대가 깔린다 → scripts/header-bar.ts
import { isRecruiting } from '@luna/db/settings';
import { type NavKey, nav } from '../content/site';
import { loadSiteData } from '../lib/data';
import Logo from './Logo.astro';

interface Props {
  current: NavKey | null;
  overlay?: boolean;
}
const { current, overlay = false } = Astro.props;
const { recruit } = (await loadSiteData()).settings;
---

<header class:list={["site-header", overlay && "is-overlay"]} data-site-header data-bar={overlay ? "off" : "on"}>
  <div class="site-header-inner container-page">
    <a href="/" class="brand tap" aria-label="LUNA 홈">
      <span class="brand-logo" data-nav-logo><Logo size={30} /></span>
      <span class="brand-word" aria-hidden="true">LUNA</span>
    </a>

    <nav aria-label="주 메뉴" class="top-tabs">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={item.key === current ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      isRecruiting(recruit) ? (
        <a href={recruit.applyUrl} class="btn btn-sm btn-primary header-cta" rel="noopener" target="_blank">
          지원하기
          <span class="sr-only">(새 창)</span>
        </a>
      ) : (
        <span class="header-cta-placeholder" aria-hidden="true" />
      )
    }
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    padding-block: 12px;
    color: var(--text);
  }
  /* 유리 막대는 별도 층으로 깔아 opacity만 바꾼다(배경 전환이 레이아웃을 건드리지 않게). */
  .site-header::before {
    content: "";
    position: absolute;
    inset: 0;
    /* 테두리 없이 반투명 바탕 + 흐림만(사용자 결정: 모든 요소에 보더 없음) */
    background: rgb(28 28 30 / 0.78);
    -webkit-backdrop-filter: blur(30px) saturate(1.8);
    backdrop-filter: blur(30px) saturate(1.8);
    opacity: 1;
    transition: opacity var(--fade-dur) ease;
    pointer-events: none;
  }
  .site-header.is-overlay {
    position: fixed;
    inset-inline: 0;
  }
  .site-header[data-bar="off"]::before {
    opacity: 0;
  }
  /* 필터 전환 동안(lib/filter-dom.ts): 흐림 대신 바탕색으로 칠해 뒤 카드가 비치지 않게 한다 */
  .site-header[data-solid]::before {
    background: var(--bg);
  }
  /* 페이지 이동 때 내비 내용은 제자리에 둔다. view-transition-name을 가진 요소는 backdrop root가 되어
     그 안쪽의 흐림은 바깥(본문)을 못 본다(Chromium). 그래서 감싸는 상자가 아니라 로고·탭 알약·버튼에 각각 단다.
     탭 알약은 이름이 자기 자신에 있어 흐림이 본문을 그대로 본다. */
  .site-header-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 44px;
  }
  .brand {
    view-transition-name: site-brand;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: inherit;
    text-decoration: none;
    border-radius: 12px;
  }
  .brand-word {
    font-size: 20px;
    line-height: 25px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  /* 넓은 화면: 위쪽 글자 탭(디자인 시스템 TabBar top) */
  .top-tabs ul {
    display: flex;
    gap: 2px;
    margin: 0;
    padding: 4px;
    list-style: none;
    border-radius: 1000px;
    view-transition-name: site-tabs;
    /* 유리: 진한 반투명 바탕(72%) + 강한 흐림으로 뒤 글자가 읽히지 않고 색과 밝기만 비친다(Apple thick material에 가깝게) */
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.1), rgb(255 255 255 / 0.03) 60%),
      rgb(44 44 46 / 0.72);
    box-shadow: inset 0 1px 1.5px -0.5px rgb(255 255 255 / 0.3);
    -webkit-backdrop-filter: blur(30px) saturate(1.8);
    backdrop-filter: blur(30px) saturate(1.8);
  }
  /* 막대가 깔렸을 때는 알약이 막대 위에 유리를 한 겹 더 얹지 않는다(HIG Materials: 유리 위에 유리를 겹치지 않는다).
     막대 자체가 흐림이므로 알약은 옅은 채움으로만 묶는다. 인트로 위(막대 없음)에서는 알약이 유일한 유리다. */
  .site-header[data-bar="on"] .top-tabs ul {
    background: var(--fill-2);
    box-shadow: none;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
  .top-tabs ul {
    transition: background-color var(--fade-dur) ease;
  }
  .top-tabs a {
    display: inline-flex;
    align-items: center;
    height: 36px;
    padding: 0 18px;
    border-radius: 1000px;
    font-size: 15px;
    font-weight: 500;
    color: inherit;
    text-decoration: none;
    transition: background-color var(--fade-dur) ease;
  }
  .top-tabs a:hover {
    background: var(--fill-2);
  }
  .top-tabs a[aria-current="page"] {
    background: var(--accent-soft);
    color: var(--accent-on-soft);
    font-weight: 600;
  }

  /* 투명도 줄이기·대비 높이기: 흐림 대신 불투명한 바탕(HIG Materials·Accessibility) */
  @media (prefers-reduced-transparency: reduce), (prefers-contrast: more) {
    .site-header::before {
      background: var(--bg);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
    .top-tabs ul {
      background: var(--surface-1);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }
  .header-cta {
    view-transition-name: site-cta;
  }

  /* 지원하기 버튼이 없을 때도 탭이 가운데에 오도록 같은 폭의 빈 자리를 둔다 */
  .header-cta-placeholder {
    width: 104px;
  }

  @media (max-width: 767px) {
    .top-tabs,
    .header-cta-placeholder {
      display: none;
    }
  }
</style>
