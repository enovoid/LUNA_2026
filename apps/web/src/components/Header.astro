---
// 상단 내비. 홈에서는 인트로 위에 투명하게 겹치고(fixed), 다른 페이지에서는 유리 막대(sticky)다.
// 인트로·소개처럼 배경이 꽉 찬 구역(data-header-clear) 위에서는 막대 없이 투명하고, 그 밖에서는 유리 막대가 깔린다 → scripts/header-bar.ts
import { isRecruiting, type NavKey, nav, site } from '../content/site';
import Logo from './Logo.astro';

interface Props {
  current: NavKey | null;
  overlay?: boolean;
}
const { current, overlay = false } = Astro.props;
---

<header class:list={["site-header", overlay && "is-overlay"]} data-site-header data-bar={overlay ? "off" : "on"}>
  <div class="site-header-inner container-page">
    <a href="/" class="brand" aria-label="LUNA 홈">
      <span class="brand-logo" data-nav-logo><Logo size={30} /></span>
      <span class="brand-word" aria-hidden="true">LUNA</span>
    </a>

    <nav aria-label="주 메뉴" class="top-tabs">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={item.key === current ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      isRecruiting ? (
        <a href={site.recruit.applyUrl} class="btn btn-sm btn-primary header-cta" rel="noopener" target="_blank">
          지원하기
          <span class="sr-only">(새 창)</span>
        </a>
      ) : (
        <span class="header-cta-placeholder" aria-hidden="true" />
      )
    }
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    padding-block: 12px;
    color: var(--color-label);
    view-transition-name: site-header;
  }
  /* 유리 막대는 별도 층으로 깔아 opacity만 바꾼다(배경 전환이 레이아웃을 건드리지 않게). */
  .site-header::before {
    content: "";
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--color-bg) 72%, transparent);
    -webkit-backdrop-filter: blur(20px) saturate(1.6);
    backdrop-filter: blur(20px) saturate(1.6);
    opacity: 1;
    transition: opacity var(--fade-dur) ease;
    pointer-events: none;
  }
  .site-header.is-overlay {
    position: fixed;
    inset-inline: 0;
  }
  .site-header[data-bar="off"]::before {
    opacity: 0;
  }
  .site-header-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 44px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: inherit;
    text-decoration: none;
    border-radius: 12px;
  }
  .brand-word {
    font-size: 20px;
    line-height: 25px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  /* 넓은 화면: 위쪽 글자 탭(디자인 시스템 TabBar top) */
  .top-tabs ul {
    display: flex;
    gap: 2px;
    margin: 0;
    padding: 4px;
    list-style: none;
    border-radius: 1000px;
    background: #ffffff14;
    -webkit-backdrop-filter: blur(16px) saturate(1.6);
    backdrop-filter: blur(16px) saturate(1.6);
  }
  .top-tabs a {
    display: inline-flex;
    align-items: center;
    height: 36px;
    padding: 0 18px;
    border-radius: 1000px;
    font-size: 15px;
    font-weight: 500;
    color: var(--color-label);
    text-decoration: none;
    transition: background-color var(--fade-dur) ease;
  }
  .top-tabs a:hover {
    background: #ffffff14;
  }
  .top-tabs a[aria-current="page"] {
    background: var(--color-lavender-tint);
    color: var(--color-accent);
    font-weight: 600;
  }

  /* 지원하기 버튼이 없을 때도 탭이 가운데에 오도록 같은 폭의 빈 자리를 둔다 */
  .header-cta-placeholder {
    width: 104px;
  }

  @media (max-width: 767px) {
    .top-tabs,
    .header-cta-placeholder {
      display: none;
    }
  }
</style>
