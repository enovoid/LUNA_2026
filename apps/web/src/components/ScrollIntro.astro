---
// 홈 첫 화면 스크롤 인트로. 밤하늘의 달 → 중간까지 확대 후 멈춤 → 달이 그 자리에서 루나 로고로 바뀜
// → "LUNA" 글자와 제목 → 구름이 닫히며 로고를 덮음 → 바탕색으로 수렴해 소개 문단과 이음새 없이 이어진다.
// 구간 표는 scripts/intro.ts.
// 움직임은 transform·opacity만 쓴다(합성 단계에서 처리돼 레이아웃·페인트를 다시 하지 않음).
// reduced-motion·JS 꺼짐·GSAP 로드 실패면 로고 + 제목 위에 구름이 반쯤 걸친 정적 화면을 한 화면으로 보여 준다.
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { site } from '../content/site';
import Logo from './Logo.astro';

const { usePhotos, desktop, mobile, mobileMedia, clouds } = site.introScene;
// 달 고해상도 파일이 둘 다 있을 때만 겹친다(없으면 깨진 이미지 대신 원래 사진만 보인다).
const hasMoonDetail = [desktop.moonDetail, mobile.moonDetail].every((src) =>
  existsSync(join(process.cwd(), 'public', src)),
);

const vars = [
  `--d-aspect:${desktop.aspect}`,
  `--d-mx:${desktop.moonX}%`,
  `--d-my:${desktop.moonY}%`,
  `--d-moon:${desktop.moonDiameter}%`,
  `--m-aspect:${mobile.aspect}`,
  `--m-mx:${mobile.moonX}%`,
  `--m-my:${mobile.moonY}%`,
  `--m-moon:${mobile.moonDiameter}%`,
  `--d-detail:${desktop.moonDetailSize}%`,
  `--m-detail:${mobile.moonDetailSize}%`,
].join(';');

const config = JSON.stringify({
  media: mobileMedia,
  desktop: {
    mx: desktop.moonX,
    my: desktop.moonY,
    moon: desktop.moonDiameter,
    aspect: desktop.aspect,
    zoom: desktop.zoom,
  },
  mobile: {
    mx: mobile.moonX,
    my: mobile.moonY,
    moon: mobile.moonDiameter,
    aspect: mobile.aspect,
    zoom: mobile.zoom,
  },
});

// 사진이 없을 때 쓰는 임시 도시 실루엣(같은 좌표계). 빌드마다 같은 모양이 나오도록 고정 난수.
let seed = 7;
const rand = () => {
  seed = (seed * 9301 + 49297) % 233280;
  return seed / 233280;
};
const buildings = Array.from({ length: 40 }, (_, i) => ({
  x: i * 2.5,
  w: 2.6,
  h: 8 + rand() * 22,
}));
const sinceYear = site.foundedYear ? ` · SINCE ${site.foundedYear}` : '';
---

<section id="luna-intro" class="intro" data-intro data-config={config} data-header-clear style={vars} aria-labelledby="intro-title">
  <div class="intro-stage">
    <div class="intro-layer" data-layer="sky" aria-hidden="true">
      {
        usePhotos ? (
          <picture>
            <source media={mobileMedia} srcset={mobile.sky} width={mobile.width} height={mobile.height} />
            <img src={desktop.sky} width={desktop.width} height={desktop.height} alt="" fetchpriority="high" decoding="async" draggable="false" />
          </picture>
        ) : (
          <div class="fake-sky">
            <span class="fake-moon" />
          </div>
        )
      }
      {
        usePhotos && hasMoonDetail && (
          <picture class="moon-detail">
            <source media={mobileMedia} srcset={mobile.moonDetail} width="1200" height="1200" />
            <img src={desktop.moonDetail} width="1200" height="1200" alt="" fetchpriority="low" decoding="async" draggable="false" />
          </picture>
        )
      }
      <div class="intro-glow"></div>
    </div>

    <div class="intro-layer" data-layer="city" aria-hidden="true">
      {
        usePhotos ? (
          <picture>
            <source media={mobileMedia} srcset={mobile.city} width={mobile.width} height={mobile.height} />
            <img src={desktop.city} width={desktop.width} height={desktop.height} alt="" decoding="async" draggable="false" />
          </picture>
        ) : (
          <svg class="fake-city" viewBox="0 0 100 100" preserveAspectRatio="none">
            {buildings.map((b) => <rect x={b.x} y={100 - b.h} width={b.w} height={b.h} />)}
          </svg>
        )
      }
    </div>

    <!-- 달 둘레만 남기고 어두워지는 막 → 어두운 배경 → (로고) → 바탕색 막 → 구름 → 아래 22% 어둠 -->
    <div class="intro-ring" data-layer="ring" aria-hidden="true"></div>
    <div class="intro-dark" data-layer="dark" aria-hidden="true"></div>
    <img class="intro-cloud intro-cloud-top" data-layer="cloudTop" src={clouds.top.src} width={clouds.top.width} height={clouds.top.height} alt="" aria-hidden="true" loading="lazy" decoding="async" draggable="false" />
    <img class="intro-cloud intro-cloud-bottom" data-layer="cloudBottom" src={clouds.bottom.src} width={clouds.bottom.width} height={clouds.bottom.height} alt="" aria-hidden="true" loading="lazy" decoding="async" draggable="false" />
    <div class="intro-fade" data-layer="fade" aria-hidden="true"></div>

    <div class="intro-content" data-layer="content">
      <div class="lockup">
        <div class="lockup-logo" data-measure="logo">
          <div class="lockup-logo-inner" data-layer="logo">
            <Logo size="100%" label="루나 로고" />
          </div>
        </div>
        <div class="lockup-window" aria-hidden="true">
          <span class="wordmark" data-layer="wordmark">LUNA</span>
        </div>
      </div>
      <div class="intro-title" data-layer="title">
        <p class="intro-eyebrow">IT SOCIAL VENTURE{sinceYear}</p>
        <h1 id="intro-title">세상을 비추는 달, LUNA</h1>
      </div>
    </div>

    <div class="intro-hint" data-layer="hint" aria-hidden="true">
      <span>스크롤해서 달에게 다가가기</span>
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8l5 5 5-5"></path></svg>
    </div>
  </div>
</section>

<noscript>
  <style>
    .intro { height: 100vh !important; height: 100svh !important; }
  </style>
</noscript>

<script>
  import "../scripts/intro";
</script>

<style>
  .intro {
    --aspect: var(--d-aspect);
    --mx: var(--d-mx);
    --my: var(--d-my);
    --moon: var(--d-moon);
    --detail: var(--d-detail);
    position: relative;
    /* 스크롤 길이: 화면 높이 × travel. 달→로고 구간은 PR #7에서 맞춘 길이 그대로, 뒤에 구름 구간을 붙였다.
       구름이 로고를 덮는 순간 고정이 풀린다(구름만 남은 채 멈춰 있는 구간 없음).
       기준값은 apps/web/README.md "스크롤 속도" */
    --travel: 3.35;
    height: calc(100vh * (var(--travel) + 1));
    height: calc(100svh * (var(--travel) + 1));
    background: var(--bg);
  }
  @media (max-aspect-ratio: 3/4) {
    .intro {
      --aspect: var(--m-aspect);
      --mx: var(--m-mx);
      --my: var(--m-my);
      --moon: var(--m-moon);
      --detail: var(--m-detail);
      --travel: 2.9;
    }
  }

  .intro-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    container-type: size;
    background: var(--bg);
  }

  /* "cover"처럼 깔되 transform-origin을 달 중심에 둔다 → 화면 비율이 달라도 달이 같은 자리에 있다 */
  .intro-layer {
    position: absolute;
    left: 50%;
    top: 50%;
    width: max(100cqw, 100cqh * var(--aspect));
    aspect-ratio: var(--aspect);
    transform-origin: var(--mx) var(--my);
    transform: translate3d(-50%, -50%, 0);
    will-change: transform;
    backface-visibility: hidden;
  }
  .intro-layer img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    user-select: none;
  }
  /* 고해상도 달: 사진의 달과 같은 중심·크기에 겹치고, 가장자리는 부드럽게 사라진다 */
  .moon-detail img {
    position: absolute;
    inset: auto;
    left: var(--mx);
    top: var(--my);
    width: var(--detail);
    height: auto;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    -webkit-mask-image: radial-gradient(closest-side, #000 86%, transparent 100%);
    mask-image: radial-gradient(closest-side, #000 86%, transparent 100%);
  }
  .intro-glow {
    position: absolute;
    left: var(--mx);
    top: var(--my);
    width: calc(var(--moon) * 2.6);
    aspect-ratio: 1;
    border-radius: 50%;
    transform: translate3d(-50%, -50%, 0);
    background: radial-gradient(circle, #efeaffcc 0%, #907fdf55 38%, #907fdf00 70%);
    opacity: 0;
    will-change: opacity;
  }

  /* 사진이 없을 때의 임시 하늘·달·도시(같은 좌표) */
  .fake-sky {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(1.5px 1.5px at 12% 18%, #fff9 50%, transparent 51%),
      radial-gradient(1px 1px at 28% 8%, #fff8 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 71% 14%, #fffa 50%, transparent 51%),
      radial-gradient(1px 1px at 86% 30%, #fff7 50%, transparent 51%),
      radial-gradient(1px 1px at 38% 36%, #fff6 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 62% 42%, #fff8 50%, transparent 51%),
      radial-gradient(ellipse at var(--mx) var(--my), #2b2a4a 0%, #14131f 45%, #0e0d14 80%);
  }
  .fake-moon {
    position: absolute;
    left: var(--mx);
    top: var(--my);
    width: var(--moon);
    aspect-ratio: 1;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle at 42% 38%, #fffdf6 0%, #f1ecdf 55%, #d9d2c2 100%);
  }
  .fake-city {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 45%;
    fill: #07060b;
  }

  /* 화면 전체를 덮는 막들. opacity만 바뀐다. */
  .intro-ring,
  .intro-dark {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    will-change: opacity;
  }
  /* 가운데가 살짝 밝은 중립 회색 → 가장자리 바탕색. 보라 기운 없이 로고만 색을 가진다. */
  .intro-ring,
  .intro-dark {
    background: radial-gradient(ellipse at 50% 46%, var(--surface-1) 0%, var(--bg) 72%);
  }
  /* 가운데 구멍 크기는 intro.ts가 달 크기로 정한다 */
  .intro-ring {
    -webkit-mask-image: radial-gradient(circle at 50% 50%, transparent calc(var(--hole, 120px) * 0.92), #000 calc(var(--hole, 120px) * 1.6));
    mask-image: radial-gradient(circle at 50% 50%, transparent calc(var(--hole, 120px) * 0.92), #000 calc(var(--hole, 120px) * 1.6));
  }
  /* 쌓는 순서: 로고·제목(1) 위로 구름(3)·아래 어둠(4)이 덮는다 → 구름이 닫히며 로고를 가린다
     (사용자 요청 2026-10-30 "구름 뒤로 로고가 숨었으면"). 안내 문구(5)는 맨 위. */
  .intro-content {
    z-index: 1;
  }
  .intro-cloud {
    z-index: 3;
  }
  .intro-fade {
    z-index: 4;
  }
  .intro-hint {
    z-index: 5;
  }

  /* 구름: 위 구름은 오른쪽 위에, 아래 구름은 가운데 아래에 붙는다. 세로 화면에서도 각각 화면 높이의 66%를 덮는다.
     이동은 자기 크기 기준 %(translate)라 화면 크기와 무관하게 "화면 밖 → 제자리"가 된다. */
  /* 구름(약 330KB)은 첫 화면 로딩과 겹치지 않게 처음엔 그리지 않는다(lazy + display:none이면 내려받지도 않음).
     intro.ts가 페이지 로드가 끝난 뒤 .has-clouds를 붙이고, 정적 화면에서는 바로 보인다. */
  .intro-cloud {
    display: none;
    position: absolute;
    height: auto;
    max-width: none;
    pointer-events: none;
    user-select: none;
    will-change: transform;
  }
  .intro-cloud-top {
    top: 0;
    right: 0;
    width: max(125cqw, 66cqh * 2);
    transform: translate3d(8%, -102%, 0);
  }
  .intro-cloud-bottom {
    bottom: 0;
    left: 50%;
    width: max(112cqw, 66cqh * 1.8);
    transform: translate3d(-56%, 102%, 0);
  }
  /* 무대 아래쪽 22%를 바탕색으로 서서히 어둡게 → 다음 섹션의 맨 윗줄과 같은 색 */
  .intro-fade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 22%;
    background: linear-gradient(to bottom, transparent, var(--bg));
    opacity: 0;
    pointer-events: none;
    will-change: opacity;
  }

  .intro-content {
    --logo: min(30vw, 200px);
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 36px;
    padding: 24px;
    text-align: center;
    color: var(--text);
    will-change: transform, opacity;
  }
  @media (max-width: 767px) {
    .intro-content {
      --logo: min(27vw, 130px);
      gap: 28px;
      padding: 16px;
    }
  }
  .lockup {
    display: flex;
    align-items: center;
  }
  .lockup-logo {
    position: relative;
    z-index: 2;
    width: var(--logo);
    aspect-ratio: 1;
    flex: 0 0 auto;
  }
  .lockup-logo-inner {
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 0 48px #907fdf66);
    opacity: 0;
    will-change: transform, opacity;
  }
  /* 로고 초승달의 안쪽(오른쪽 열린 곳)에서 글자가 미끄러져 나온다. 창 밖은 잘려 보이지 않는다. */
  .lockup-window {
    position: relative;
    z-index: 1;
    margin-left: calc(var(--logo) * -0.3);
    padding-left: calc(var(--logo) * 0.36);
    overflow: hidden;
  }
  .wordmark {
    display: block;
    font-size: calc(var(--logo) * 0.5);
    line-height: 1;
    font-weight: 700;
    letter-spacing: 0.06em;
    background: linear-gradient(100deg, #efeaff 0%, #907fdf 60%, #8577d6 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    transform: translate3d(calc(-100% - var(--logo) * 0.5), 0, 0);
    will-change: transform;
  }
  .intro-title {
    opacity: 0;
    transform: translate3d(0, 24px, 0);
    will-change: transform, opacity;
  }
  .intro-eyebrow {
    margin: 0 0 12px;
    font-size: 15px;
    line-height: 20px;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--text-2);
  }
  h1 {
    margin: 0;
    font-size: clamp(28px, 4.4vw, 56px);
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .intro-hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    font-size: 15px;
    line-height: 20px;
    color: var(--text);
    text-shadow: 0 1px 8px var(--bg);
    will-change: opacity;
  }
  @media (max-width: 767px) {
    /* 하단 탭 바와 겹치지 않게 */
    .intro-hint {
      bottom: calc(96px + env(safe-area-inset-bottom));
    }
  }

  /* 정적 화면: 움직임 줄이기 설정, JS 꺼짐, GSAP 로드 실패.
     어두운 배경 위 로고 + 제목, 구름이 반쯤(진행도 약 45%) 걸친 장식(로고는 구름 위). */
  .intro.is-static,
  :global(html:not(.js)) .intro {
    height: 100vh;
    height: 100svh;
  }
  .intro.is-static :is(.intro-layer, .intro-ring, .intro-hint),
  :global(html:not(.js)) .intro :is(.intro-layer, .intro-ring, .intro-hint) {
    display: none;
  }
  .intro.is-static :is(.intro-dark, .lockup-logo-inner, .wordmark, .intro-title, .intro-fade),
  :global(html:not(.js)) .intro :is(.intro-dark, .lockup-logo-inner, .wordmark, .intro-title, .intro-fade) {
    opacity: 1;
    transform: none;
  }
  /* 정적 화면은 한 장의 장면이라 로고·제목이 구름 위에 보여야 한다 */
  .intro.is-static .intro-content,
  :global(html:not(.js)) .intro .intro-content {
    z-index: 5;
  }
  .intro.has-clouds .intro-cloud,
  .intro.is-static .intro-cloud,
  :global(html:not(.js)) .intro .intro-cloud {
    display: block;
  }
  .intro.is-static .intro-cloud-top,
  :global(html:not(.js)) .intro .intro-cloud-top {
    transform: translate3d(4.4%, -56%, 0);
  }
  .intro.is-static .intro-cloud-bottom,
  :global(html:not(.js)) .intro .intro-cloud-bottom {
    transform: translate3d(-53.3%, 56%, 0);
  }
  @media (prefers-reduced-motion: reduce) {
    .intro {
      height: 100vh;
      height: 100svh;
    }
    .intro-layer,
    .intro-ring,
    .intro-hint {
      display: none;
    }
    .intro-dark,
    .lockup-logo-inner,
    .wordmark,
    .intro-title,
    .intro-fade {
      opacity: 1;
      transform: none;
    }
    .intro-cloud {
      display: block;
    }
    .intro-content {
      z-index: 5;
    }
    .intro-cloud-top {
      transform: translate3d(4.4%, -56%, 0);
    }
    .intro-cloud-bottom {
      transform: translate3d(-53.3%, 56%, 0);
    }
  }
</style>
