---
// 크레딧 한 줄: 작은 네모 사진, 큰 이름, 직군·학번은 열을 맞춰 작게. 장식(테두리·칩·그림자) 없이 글자 크기와 정렬로만 위계를 만든다.
// 소개글이 있으면 <details>로 그 자리에서 펼친다. id가 멤버 앵커라서 /members#member-… 링크로 열 수 있다(scripts/member-row.ts).
import { memberAnchor } from '../lib/content';
import type { Member } from '../lib/data';
import Picture from './Picture.astro';

interface Props {
  member: Member;
}
const { member } = Astro.props;
const meta = [member.schoolGeneration, member.className].filter(Boolean).join(' · ');
const Tag = member.description ? 'details' : 'div';
const Head = member.description ? 'summary' : 'div';
---

<Tag class="row" id={memberAnchor(member)}>
  <Head class="row-head">
    <Picture image={member.image} alt="" ratio="1 / 1" sizes="56px" class="row-photo">
      <span class="row-initial" aria-hidden="true">{member.name.slice(0, 1)}</span>
    </Picture>
    <span class="row-name">{member.name}</span>
    <span class="row-position">{member.position}</span>
    <span class="row-meta">{meta}</span>
    {member.description && <span class="row-toggle" aria-hidden="true">+</span>}
  </Head>
  {
    member.description && (
      <div class="row-body">
        {meta && <p class="row-body-meta">{meta}</p>}
        <p class="row-desc">{member.description}</p>
      </div>
    )
  }
</Tag>

<style>
  .row {
    scroll-margin-top: 96px;
  }
  .row-head {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) 24px;
    grid-template-areas:
      "photo name toggle"
      "photo position toggle";
    align-items: center;
    column-gap: 14px;
    padding: 12px 0;
    list-style: none;
  }
  .row-head::-webkit-details-marker {
    display: none;
  }
  summary.row-head {
    cursor: pointer;
  }
  summary.row-head:focus-visible {
    outline: 2px solid var(--accent, var(--color-accent));
    outline-offset: 4px;
    border-radius: 4px;
  }
  .row-head :global(.row-photo) {
    grid-area: photo;
    width: 44px;
    border-radius: 6px;
    background: var(--surface-1, var(--color-card));
  }
  .row-initial {
    font-size: 17px;
    font-weight: 600;
    color: var(--text-2, var(--color-label-2));
  }
  .row-name {
    grid-area: name;
    font-size: 20px;
    line-height: 25px;
    font-weight: 600;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
    transition: color var(--fade-dur) ease;
  }
  .row-position {
    grid-area: position;
    font-size: 15px;
    line-height: 20px;
    color: var(--text-2, var(--color-label-2));
  }
  .row-meta {
    display: none;
  }
  /* 펼칠 수 있는 줄 표시. 열리면 +가 45도 돌아 ×가 된다(transform만). */
  .row-toggle {
    grid-area: toggle;
    justify-self: end;
    font-size: 22px;
    line-height: 1;
    font-weight: 300;
    color: var(--text-2, var(--color-label-2));
    transition: transform var(--spring-snappy-dur) var(--spring-snappy);
  }
  details[open] .row-toggle {
    transform: rotate(45deg);
  }
  /* 펼쳐지면 이름이 강조색으로 바뀌어 어느 줄이 열렸는지 보인다. */
  details[open] .row-name {
    color: var(--accent, var(--color-accent));
  }
  @media (hover: hover) {
    summary.row-head:hover .row-name {
      color: var(--accent, var(--color-accent));
    }
  }

  .row-body {
    padding: 0 0 20px 58px;
  }
  .row-body p {
    margin: 0;
    max-width: 34em;
  }
  .row-body-meta {
    font-size: 15px;
    line-height: 20px;
    color: var(--text-2, var(--color-label-2));
  }
  .row-desc {
    margin-top: 8px !important;
    font-size: 17px;
    line-height: 27px;
    white-space: pre-line;
  }
  /* 펼친 내용은 아래로 밀리는 대신 제자리에서 살짝 올라오며 나타난다(transform·opacity만). */
  @media (prefers-reduced-motion: no-preference) {
    details[open] .row-body {
      animation: row-in var(--spring-smooth-dur) var(--spring-smooth) both;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    details[open] .row-body {
      animation: row-fade var(--fade-dur) ease both;
    }
  }
  @keyframes row-in {
    from {
      opacity: 0;
      transform: translate3d(0, -8px, 0);
    }
  }
  @keyframes row-fade {
    from {
      opacity: 0;
    }
  }

  /* 넓은 화면: 이름 · 직군 · 학번을 세 열로 맞춘다(크레딧 정렬). 학번은 숫자 폭을 고정해 줄끼리 맞춘다. */
  @media (min-width: 768px) {
    .row-head {
      grid-template-columns: 56px minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr) 24px;
      grid-template-areas: "photo name position meta toggle";
      column-gap: 24px;
      padding: 14px 0;
    }
    .row-head :global(.row-photo) {
      width: 56px;
      border-radius: 8px;
    }
    .row-name {
      font-size: 28px;
      line-height: 34px;
    }
    .row-meta {
      display: block;
      grid-area: meta;
      font-size: 15px;
      line-height: 20px;
      color: var(--text-2, var(--color-label-2));
      font-variant-numeric: tabular-nums;
      text-align: right;
    }
    .row-body {
      padding-left: 80px;
    }
    .row-body-meta {
      display: none;
    }
  }
</style>
