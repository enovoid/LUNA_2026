---
// 멤버 보기 전환: 기수별 / 직군별. 선택값은 ?view=position 으로 URL에 남는다(기수별이 기본).
// 두 칸의 폭이 같아서 선택 표시(thumb)는 width 변화 없이 transform만으로 옮긴다.
// 두 보기는 Astro가 미리 그려 두고, 여기서는 hidden만 바꾼다. 첫 페인트 전 적용은 MemberViewBoot.
---

<div class="view-toggle" role="radiogroup" aria-label="보기 방식" data-view-toggle>
  <span class="view-thumb" aria-hidden="true"></span>
  <button type="button" role="radio" aria-checked="true" data-view="generation">기수별</button>
  <button type="button" role="radio" aria-checked="false" tabindex="-1" data-view="position">직군별</button>
</div>

<script>
  const toggle = document.querySelector<HTMLElement>('[data-view-toggle]');
  const buttons = [...(toggle?.querySelectorAll<HTMLButtonElement>('[data-view]') ?? [])];

  function show(view: string) {
    for (const b of buttons) {
      const on = b.dataset.view === view;
      b.setAttribute('aria-checked', String(on));
      b.tabIndex = on ? 0 : -1;
    }
    for (const el of document.querySelectorAll<HTMLElement>('[data-member-view]')) {
      el.hidden = el.dataset.memberView !== view;
    }
    const url = new URL(location.href);
    if (view === 'generation') url.searchParams.delete('view');
    else url.searchParams.set('view', view);
    history.replaceState(history.state, '', url);
  }

  function select(view: string) {
    const current = buttons.find((b) => b.getAttribute('aria-checked') === 'true')?.dataset.view;
    if (view === current) return;
    // 묶음이 통째로 바뀌므로 화면 전체를 크로스페이드로 잇는다(지원하지 않으면 바로 바꿈).
    if (document.startViewTransition) document.startViewTransition(() => show(view));
    else show(view);
  }

  for (const [i, b] of buttons.entries()) {
    b.addEventListener('click', () => select(b.dataset.view ?? 'generation'));
    b.addEventListener('keydown', (e) => {
      if (!['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown'].includes(e.key)) return;
      e.preventDefault();
      const next = buttons[(i + 1) % buttons.length];
      next.focus();
      select(next.dataset.view ?? 'generation');
    });
  }
</script>

<style>
  .view-toggle {
    position: relative;
    display: inline-grid;
    grid-template-columns: 1fr 1fr;
    padding: 2px;
    border-radius: 1000px;
    background: var(--color-fill-3);
  }
  .view-thumb {
    position: absolute;
    top: 2px;
    bottom: 2px;
    left: 2px;
    width: calc(50% - 2px);
    border-radius: 1000px;
    background: var(--misc-segmented-control-selected-fill);
    pointer-events: none;
    transition: transform var(--spring-snappy-dur) var(--spring-snappy);
  }
  .view-toggle:has([data-view="position"][aria-checked="true"]) .view-thumb {
    transform: translate3d(100%, 0, 0);
  }
  @media (prefers-reduced-motion: reduce) {
    .view-thumb {
      transition: none;
    }
  }
  button {
    position: relative;
    min-width: 72px;
    height: 32px;
    padding: 0 14px;
    border: 0;
    border-radius: 1000px;
    background: transparent;
    color: var(--text, var(--color-label));
    font: inherit;
    font-size: 13.33px;
    line-height: 18px;
    font-weight: 500;
    cursor: pointer;
  }
  button[aria-checked="true"] {
    font-weight: 600;
  }
  button:focus-visible {
    outline: 2px solid var(--accent, var(--color-accent));
    outline-offset: -2px;
  }
</style>
