---
import EmptyState from '../components/EmptyState.astro';
import MemberRow from '../components/MemberRow.astro';
import PageHead from '../components/PageHead.astro';
import Base from '../layouts/Base.astro';
import { generationNumber, groupMembersByGeneration } from '../lib/content';
import { loadSiteData } from '../lib/data';

const { members } = await loadSiteData();
const groups = groupMembersByGeneration(members).map((g) => {
  const n = generationNumber(g.generation);
  // "LUNA 8기" → 큰 숫자 "08". 숫자가 없는 묶음(기수 미정)은 이름을 그대로 쓴다.
  return { ...g, numeral: n >= 0 ? String(n).padStart(2, '0') : null };
});
---

<Base title="멤버" description="루나를 만들어 가는 사람들을 기수별로 소개합니다." current="members">
  <PageHead title="멤버" lead="루나를 만들어 가는 사람들입니다." />

  <div class="container-page page-body">
    {
      members.length === 0 ? (
        <EmptyState title="아직 소개할 멤버가 없어요" message="멤버가 등록되면 기수별로 보여요." />
      ) : (
        groups.map((g, i) => (
          <section class="gen" aria-labelledby={`gen-${i}`}>
            <div class="gen-head">
              <h2 id={`gen-${i}`}>
                {g.numeral ? (
                  <>
                    <span class="gen-num" aria-hidden="true">{g.numeral}</span>
                    <span class="sr-only">{g.generation}</span>
                    <span class="gen-label" aria-hidden="true">{g.generation}</span>
                  </>
                ) : (
                  <span class="gen-label gen-label-only">{g.generation}</span>
                )}
              </h2>
              <p class="gen-count">{g.members.length}명</p>
            </div>
            <ol class="roll">
              {g.members.map((m) => (
                <li>
                  <MemberRow member={m} />
                </li>
              ))}
            </ol>
          </section>
        ))
      )
    }
  </div>
</Base>

<script>
  import '../scripts/member-row';
</script>

<style>
  .page-body {
    display: flex;
    flex-direction: column;
    gap: 72px;
    padding-top: 40px;
    padding-bottom: 120px;
  }
  .gen {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .gen-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
  }
  .gen-head h2 {
    display: flex;
    flex-direction: column;
    margin: 0;
  }
  /* 기수 숫자가 이 페이지의 주인공. 크게, 촘촘하게, 숫자 폭 고정. */
  .gen-num {
    font-size: clamp(88px, 22vw, 168px);
    line-height: 0.86;
    font-weight: 600;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
    color: var(--text, var(--color-label));
  }
  .gen-label {
    margin-top: 10px;
    font-size: 13px;
    line-height: 18px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent, var(--color-accent));
  }
  .gen-label-only {
    margin-top: 0;
    font-size: 28px;
    line-height: 34px;
    letter-spacing: 0;
    text-transform: none;
    color: var(--text, var(--color-label));
  }
  .gen-count {
    margin: 0;
    font-size: 15px;
    line-height: 20px;
    color: var(--text-2, var(--color-label-2));
    font-variant-numeric: tabular-nums;
  }
  .roll {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* 넓은 화면: 왼쪽에 기수 숫자를 붙여 두고(스크롤해도 머무름) 오른쪽에 명단을 흘린다. */
  @media (min-width: 900px) {
    .page-body {
      gap: 120px;
      padding-top: 64px;
    }
    .gen {
      display: grid;
      grid-template-columns: minmax(220px, 3fr) 9fr;
      column-gap: 48px;
      align-items: start;
    }
    .gen-head {
      position: sticky;
      top: 96px;
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
    .roll {
      padding-top: 4px;
    }
  }
</style>
