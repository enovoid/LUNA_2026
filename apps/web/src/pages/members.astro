---
// 예전 루나 사이트(luna-landing)처럼 기수 탭으로 한 기수씩 보여 준다. 탭은 알약 대신 글자만으로, 선택된 기수는 밝은 글자와 큰 제목으로 드러난다.
import EmptyState from '../components/EmptyState.astro';
import MemberCard from '../components/MemberCard.astro';
import PageHead from '../components/PageHead.astro';
import Base from '../layouts/Base.astro';
import { generationNumber, groupMembersByGeneration } from '../lib/content';
import { loadSiteData } from '../lib/data';

const { members } = await loadSiteData();
const groups = groupMembersByGeneration(members).map((g) => {
  const n = generationNumber(g.generation);
  return { ...g, key: n >= 0 ? String(n) : g.generation };
});
---

<Base title="멤버" description="디미고 IT 소셜벤처 동아리 루나(LUNA)의 멤버를 소개합니다." current="members">
  <PageHead title="멤버" />

  <div class="container-page page-body">
    {
      members.length === 0 ? (
        <EmptyState title="멤버가 없습니다" />
      ) : (
        <>
          <div class="gen-tabs" role="tablist" aria-label="기수">
            {groups.map((g, i) => (
              <button
                type="button"
                role="tab"
                id={`gen-tab-${g.key}`}
                aria-controls={`gen-panel-${g.key}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                data-gen-tab={g.key}
              >
                {g.generation}
              </button>
            ))}
          </div>
          {groups.map((g, i) => (
            <section
              class="gen"
              role="tabpanel"
              id={`gen-panel-${g.key}`}
              aria-labelledby={`gen-tab-${g.key}`}
              data-gen-panel={g.key}
              hidden={i !== 0}
            >
              <h2>
                {g.generation} <span>{g.members.length}명</span>
              </h2>
              <ul class="member-grid">
                {g.members.map((m) => (
                  <li>
                    <MemberCard member={m} />
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </>
      )
    }
  </div>
  {/* 첫 페인트 전에 ?gen= 또는 #member-… 에 맞는 기수를 열어 둔다(레이아웃이 흔들리지 않게). 규칙은 scripts/member-gen.ts와 같다. */}
  <script is:inline>
    (() => {
      const hash = decodeURIComponent(location.hash.slice(1));
      const card = hash && document.getElementById(hash);
      const panel = card && card.closest("[data-gen-panel]");
      const key = panel ? panel.dataset.genPanel : new URLSearchParams(location.search).get("gen");
      if (!key || !document.querySelector(`[data-gen-panel="${CSS.escape(key)}"]`)) return;
      for (const p of document.querySelectorAll("[data-gen-panel]")) p.hidden = p.dataset.genPanel !== key;
      for (const t of document.querySelectorAll("[data-gen-tab]")) {
        const on = t.dataset.genTab === key;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
      }
    })();
  </script>
</Base>

<script>
  import '../scripts/member-gen';
</script>

<style>
  .page-body {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-top: 32px;
    padding-bottom: 120px;
  }
  /* 기수 탭: 테두리·알약 없이 글자만. 선택된 탭은 밝은 글자, 나머지는 흐린 글자. 넘치면 가로로 스크롤. */
  .gen-tabs {
    display: flex;
    gap: 4px 24px;
    margin-inline: calc(-1 * var(--margin));
    padding-inline: var(--margin);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .gen-tabs::-webkit-scrollbar {
    display: none;
  }
  .gen-tabs button {
    flex: none;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--text-2, var(--color-label-2));
    font: inherit;
    font-size: 17px;
    line-height: 22px;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    transition: color var(--fade-dur) ease;
  }
  .gen-tabs button[aria-selected="true"] {
    color: var(--text, var(--color-label));
  }
  @media (hover: hover) {
    .gen-tabs button:hover {
      color: var(--text, var(--color-label));
    }
  }
  .gen-tabs button:focus-visible {
    outline: 2px solid var(--accent, var(--color-accent));
    outline-offset: 2px;
    border-radius: 4px;
  }
  .gen {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .gen[hidden] {
    display: none;
  }
  .gen h2 {
    margin: 0;
    font-size: clamp(34px, 6vw, 48px);
    line-height: 1.17;
    font-weight: 700;
  }
  .gen h2 span {
    font-size: 17px;
    font-weight: 500;
    color: var(--text-2, var(--color-label-2));
  }
  .member-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 56px 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 768px) {
    .page-body {
      padding-top: 48px;
    }
    .gen-tabs {
      margin-inline: 0;
      padding-inline: 0;
    }
    .member-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 80px 48px;
    }
  }
</style>
