---
import EmptyState from '../components/EmptyState.astro';
import Filter from '../components/Filter.astro';
import FilterBoot from '../components/FilterBoot.astro';
import MemberCard from '../components/MemberCard.astro';
import MemberSheet from '../components/MemberSheet.astro';
import MemberViewBoot from '../components/MemberViewBoot.astro';
import MemberViewToggle from '../components/MemberViewToggle.astro';
import PageHead from '../components/PageHead.astro';
import Base from '../layouts/Base.astro';
import { groupMembersByGeneration, groupMembersByPosition, uniqueSorted } from '../lib/content';
import { loadSiteData } from '../lib/data';

const { members } = await loadSiteData();
const views = [
  {
    key: 'generation',
    groups: groupMembersByGeneration(members).map((g) => ({
      title: g.generation,
      members: g.members,
    })),
    detail: 'position',
  },
  {
    key: 'position',
    groups: groupMembersByPosition(members).map((g) => ({ title: g.position, members: g.members })),
    detail: 'generation',
  },
] as const;
const positions = uniqueSorted(members.map((m) => m.position));
---

<Base title="멤버" description="루나를 만들어 가는 사람들을 기수별로 소개합니다." current="members">
  <PageHead title="멤버" lead="루나를 만들어 가는 사람들입니다.">
    <div class="controls">
      {members.length > 0 && <MemberViewToggle />}
      <Filter label="직군" param="position" options={positions} unit="명" />
    </div>
  </PageHead>

  <div class="container-page page-body" data-filter-scope="position">
    {
      members.length === 0 ? (
        <EmptyState title="아직 소개할 멤버가 없어요" message="멤버가 등록되면 기수별로 보여요." />
      ) : (
        views.map((v) => (
          <div class="view" data-member-view={v.key} hidden={v.key !== 'generation'}>
            {v.groups.map((g, i) => (
              <section class="gen" data-filter-group aria-labelledby={`${v.key}-${i}`}>
                <div class="gen-head">
                  <h2 id={`${v.key}-${i}`}>{g.title}</h2>
                  <span>{g.members.length}명</span>
                </div>
                <ul class="member-grid">
                  {g.members.map((m) => (
                    <li data-filter-item data-position={m.position}>
                      <MemberCard member={m} detail={v.detail} />
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        ))
      )
    }
    <EmptyState title="이 직군의 멤버가 없어요" message="다른 직군을 골라 보세요." filterEmpty />
  </div>
  {members.map((m) => <MemberSheet member={m} />)}
  <FilterBoot param="position" />
  <MemberViewBoot />
</Base>

<script>
  import '../scripts/member-sheet';
</script>

<style>
  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    max-width: 100%;
  }
  .view {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .view[hidden] {
    display: none;
  }
  .page-body {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-top: 32px;
    padding-bottom: 96px;
  }
  .gen {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .gen-head {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .gen-head h2 {
    margin: 0;
    font-size: 28px;
    line-height: 34px;
    font-weight: 700;
  }
  .gen-head span {
    font-size: 15px;
    line-height: 20px;
    color: var(--text-2, var(--color-label-2));
  }
  .member-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 768px) {
    .member-grid {
      grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
      gap: 12px 20px;
    }
  }
</style>
