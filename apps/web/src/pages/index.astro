---
import { recruitPeriod, recruitState } from '@luna/db/settings';
import EmptyState from '../components/EmptyState.astro';
import FaqList from '../components/FaqList.astro';
import Logo from '../components/Logo.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ScrollIntro from '../components/ScrollIntro.astro';
import Base from '../layouts/Base.astro';
import {
  computeStats,
  formatDate,
  formatWon,
  sortAwards,
  sortFaqs,
  sortProjects,
  textToParagraphs,
} from '../lib/content';
import { loadSiteData } from '../lib/data';

const { members, awards, projects, faqs, settings } = await loadSiteData();
const { recruit, contact } = settings;
// 모집 상태는 빌드한 날(한국 날짜) 기준이다. 사이트 서버가 매일 0시에 다시 빌드한다.
const recruiting = recruitState(recruit);
const isRecruiting = recruiting === 'open';
const recruitNote = {
  none: '',
  upcoming: '곧 지원을 받아요',
  open: '',
  closed: '모집이 마감됐어요. 다음 모집 때 만나요!',
}[recruiting];
const stats = computeStats(members, awards);
const sortedFaqs = sortFaqs(faqs);
// 홈에는 앞의 질문 몇 개만 보이고 나머지는 FAQ 페이지에서 본다.
const homeFaqs = sortedFaqs.slice(0, 3);
const intro = sortedFaqs[0]?.answer ?? '';
const latestProjects = sortProjects(projects).slice(0, 6);
const latestAwards = sortAwards(awards).slice(0, 3);
// data-count: 화면에 들어오면 0부터 이 값까지 세어 올라간다(scripts/count-up.ts). JS가 없으면 처음부터 최종값.
const statItems = [
  {
    value: `${stats.awardCount.toLocaleString('ko-KR')}회`,
    count: stats.awardCount,
    format: 'count',
    unit: '회',
    label: '수상',
  },
  {
    value: formatWon(stats.prizeTotal),
    count: stats.prizeTotal,
    format: 'won',
    unit: '',
    label: '상금',
  },
  {
    value: `${stats.memberCount.toLocaleString('ko-KR')}명`,
    count: stats.memberCount,
    format: 'count',
    unit: '명',
    label: '멤버',
  },
];
// 소개 문단을 낱말로 나눈다. 스크롤하면 줄 단위로 밝아진다(CSS 스크롤 타임라인, JS 없음).
const aboutParagraphs = (intro ? textToParagraphs(intro) : ['세상을 비추는 달, LUNA']).map((p) =>
  p.split(/\s+/).filter(Boolean),
);
---

<Base current="home" overlayHeader>
  <ScrollIntro slot="hero" />

  <section class="about" data-header-clear aria-label="루나 소개">
    <div class="about-inner">
      {
        aboutParagraphs.map((words) => (
          <p class="about-text">
            {words.map((w) => (
              <span class="hl-word">{w} </span>
            ))}
          </p>
        ))
      }
      <div class="about-actions" data-reveal>
        <a href="/projects" class="btn btn-primary">프로젝트</a>
        <a href={recruiting === "none" ? "/faq" : "#apply"} class="btn btn-ghost">지원</a>
      </div>
    </div>
  </section>

  <div class="home-sections">
    <section aria-labelledby="stats-title" class="container-page section-stack">
      <div class="headline" data-reveal>
        <span class="eyebrow">BY THE NUMBERS</span>
        <h2 id="stats-title">루나</h2>
      </div>
      <ul class="stats" data-reveal>
        {
          statItems.map((s, i) => (
            <li class="stat card" data-reveal-item style={`--i:${i}`}>
              <span class="stat-value" data-count={s.count} data-count-format={s.format} data-count-unit={s.unit}>
                {s.value}
              </span>
              <span class="stat-label">{s.label}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="projects" aria-labelledby="projects-title" class="section-stack">
      <div class="container-page section-head" data-reveal>
        <div class="headline">
          <span class="eyebrow">PROJECTS</span>
          <h2 id="projects-title">프로젝트</h2>
        </div>
        {latestProjects.length > 0 && <a href="/projects" class="more-link">모두 보기</a>}
      </div>
      {
        latestProjects.length > 0 ? (
          <div class="gallery container-page" data-gallery data-reveal>
            <ul class="gallery-track" data-gallery-track aria-label="최근 프로젝트">
              {latestProjects.map((p, i) => (
                <li class="gallery-item" data-reveal-item style={`--i:${i}`}>
                  <ProjectCard project={p} compact headingLevel={3} />
                </li>
              ))}
            </ul>
            <div class="gallery-nav" data-gallery-nav>
              <button type="button" class="paddle pressable" data-gallery-prev aria-label="이전 프로젝트">
                <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.5 4.5 7 10l5.5 5.5" /></svg>
              </button>
              <button type="button" class="paddle pressable" data-gallery-next aria-label="다음 프로젝트">
                <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.5 4.5 13 10l-5.5 5.5" /></svg>
              </button>
            </div>
          </div>
        ) : (
          <div class="container-page">
            <EmptyState title="프로젝트가 없습니다" />
          </div>
        )
      }
    </section>

    <section id="awards" aria-labelledby="awards-title" class="container-page">
      <div class="split" data-reveal>
        <div class="split-aside">
          <span class="eyebrow">AWARDS</span>
          <h2 id="awards-title">수상</h2>
          {latestAwards.length > 0 && <a href="/awards" class="more-link">모두 보기</a>}
        </div>
        <div class="split-main">
          {
            latestAwards.length > 0 ? (
              <ul class="list card">
                {latestAwards.map((a) => (
                  <li>
                    <a href={`/awards?year=${encodeURIComponent(a.year)}`} class="list-row">
                      <span class="list-text">
                        <span class="list-title">{a.name}</span>
                        <span class="list-sub">{[a.prize, a.team && `팀 ${a.team}`, formatDate(a.date)].filter(Boolean).join(" · ")}</span>
                      </span>
                      {a.prizeMoney ? <span class="list-detail">{formatWon(a.prizeMoney)}</span> : null}
                      <span class="list-chevron" aria-hidden="true">›</span>
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <EmptyState title="수상 기록이 없습니다" />
            )
          }
        </div>
      </div>
    </section>

    <section id="faq" aria-labelledby="faq-title" class="container-page">
      <div class="split" data-reveal>
        <div class="split-aside">
          <span class="eyebrow">FAQ</span>
          <h2 id="faq-title">자주 묻는 질문</h2>
          {sortedFaqs.length > 0 && <a href="/faq" class="more-link">모두 보기</a>}
        </div>
        <div class="split-main">
          {
            homeFaqs.length > 0 ? (
              <FaqList faqs={homeFaqs} openFirst={1} idPrefix="home-faq" />
            ) : (
              <EmptyState title="질문이 없습니다" message={contact.email || undefined} />
            )
          }
        </div>
      </div>
    </section>

    {
      recruiting !== "none" && (
        <section id="apply" aria-labelledby="apply-title" class="container-page">
          <div class="apply">
            <Logo size={320} class="apply-mark" />
            <div class="apply-text">
              <span class="apply-eyebrow">{recruiting === "closed" ? "CLOSED" : "RECRUITING"}</span>
              <h2 id="apply-title">LUNA {recruit.generation} {recruiting === "closed" ? "모집 마감" : "모집"}</h2>
              <p>{[recruitPeriod(recruit), recruit.target].filter(Boolean).join(" · ")}</p>
              {recruitNote && <p class="apply-note">{recruitNote}</p>}
            </div>
            {
              isRecruiting && (
                <a href={recruit.applyUrl} class="btn btn-primary apply-cta" target="_blank" rel="noopener">
                  지원하기<span class="sr-only">(새 창)</span>
                </a>
              )
            }
          </div>
        </section>
      )
    }
  </div>
</Base>

<style>
  /* 소개: 인트로의 밤하늘에서 그대로 이어진다. 낱말이 화면 아래에서 가운데로 올라오는 동안 밝아진다(Apple 제품 페이지의 줄 하이라이트). */
  .about {
    display: flex;
    justify-content: center;
    /* 인트로 바로 아래: 서브픽셀 틈을 덮도록 1px 겹친다. 바탕은 인트로 끝과 같은 var(--bg) 하나. */
    margin-top: -1px;
    padding: 96px 24px 136px;
    background: var(--bg);
  }
  .about-inner {
    width: 100%;
    max-width: 920px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    text-align: center;
  }
  .about-text {
    margin: 0;
    font-size: clamp(24px, 3.6vw, 44px);
    line-height: 1.4;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .hl-word {
        animation: hl-word linear both;
        animation-timeline: view();
        animation-range: cover 12% cover 42%;
      }
    }
  }
  @keyframes hl-word {
    from {
      opacity: 0.2;
    }
    to {
      opacity: 1;
    }
  }
  .about-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  /* 아래 구역: 섹션 사이는 줄 대신 넓은 여백으로 나눈다(장식 빛 없음, 색은 강조에만). */
  .home-sections {
    display: flex;
    flex-direction: column;
    gap: 96px;
    padding: 24px 0 120px;
    background: var(--bg);
  }
  @media (min-width: 768px) {
    .home-sections {
      gap: 128px;
    }
  }

  /* 큰 제목 + 작은 영문 머리글(Apple 섹션 헤드라인) */
  .headline {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .eyebrow {
    font-size: 13px;
    line-height: 18px;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--text-2);
  }
  h2 {
    margin: 0;
    font-size: clamp(32px, 4.4vw, 48px);
    line-height: 1.12;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .section-stack {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
  }
  .more-link {
    font-size: 17px;
    font-weight: 600;
  }

  /* 숫자: 큰 그라데이션 숫자 + 작은 설명. 세어 올라가는 동안에도 칸 크기는 그대로(tabular-nums, 한 줄). */
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 32px 28px;
  }
  .stat-value {
    font-size: clamp(40px, 4.6vw, 56px);
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .stat-label {
    font-size: 17px;
    line-height: 24px;
    color: var(--color-label-2);
  }

  /* 프로젝트 갤러리(Apple 카드 선반 방식).
     넓은 화면: 본문 칸 안에 카드 3장이 꼭 맞게 들어가고 양쪽 끝이 제목·버튼과 같은 선에 선다. 버튼은 3장씩 넘긴다.
     좁은 화면: 칸을 화면 끝까지 넓히되 양쪽에 같은 여백을 두어, 처음엔 첫 카드가 왼쪽 선에, 끝까지 넘기면 마지막 카드가
     오른쪽 선에 맞는다. 다음 카드가 살짝 보여 옆으로 넘길 수 있다는 걸 알려 준다(iOS 가로 목록과 같은 방식). */
  .gallery {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .gallery-track {
    --gap: 16px;
    --gutter: 0px;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 2 * var(--gap)) / 3);
    gap: var(--gap);
    margin: 0 calc(-1 * var(--gutter));
    padding: 4px var(--gutter) 8px;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
  }
  @media (max-width: 1023px) {
    .gallery-track {
      grid-auto-columns: calc((100% - var(--gap)) / 2);
    }
  }
  @media (max-width: 767px) {
    .gallery-track {
      --gap: 12px;
      --gutter: var(--margin);
      grid-auto-columns: calc(100% - 28px);
    }
  }
  .gallery-track::-webkit-scrollbar {
    display: none;
  }
  .gallery-item {
    scroll-snap-align: start;
  }
  .gallery-nav {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
  }
  /* 버튼 자리는 처음부터 잡아 두고(CLS 0), 넘길 카드가 있을 때만 보인다. */
  .gallery-nav:not(.is-active) {
    visibility: hidden;
  }
  .paddle {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: var(--fill-1);
    color: var(--text);
    cursor: pointer;
    transition:
      background-color var(--fade-dur) ease,
      opacity var(--fade-dur) ease,
      transform var(--spring-snappy-dur) var(--spring-snappy);
  }
  .paddle:hover {
    background: var(--fill-1-hover);
  }
  .paddle:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .split {
    display: flex;
    flex-wrap: wrap;
    gap: 24px 32px;
  }
  .split-aside {
    flex: 1 1 280px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .split-main {
    flex: 999 1 560px;
    min-width: 0;
  }

  /* 목록(디자인 시스템 List + ListRow) */
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
    overflow: hidden;
  }
  .list-row {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 60px;
    padding: 12px 20px;
    color: inherit;
    text-decoration: none;
    transition: background-color var(--fade-dur) ease;
  }
  .list-row:hover {
    background: var(--surface-2);
    text-decoration: none;
  }
  .list-row:active {
    background: var(--surface-2);
    transition-duration: var(--press-dur);
  }
  .list-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .list-title {
    font-size: 17px;
    line-height: 22px;
    font-weight: 600;
  }
  .list-sub {
    font-size: 15px;
    line-height: 20px;
    color: var(--color-label-2);
  }
  .list-detail {
    font-size: 17px;
    color: var(--color-label-2);
    font-variant-numeric: tabular-nums;
  }
  .list-chevron {
    font-size: 22px;
    color: var(--color-label-2);
  }

  /* 모집 카드: 화면에 들어오며 조금 작은 크기에서 제 크기로 커진다(스크롤에 묶임, Apple의 프레임 진입). */
  .apply {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding: 40px 28px;
    border-radius: 34px;
    background: var(--surface-1);
  }
  @media (min-width: 768px) {
    .apply {
      padding: 48px;
    }
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .apply {
        animation: frame-in linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 35%;
      }
    }
  }
  @keyframes frame-in {
    from {
      opacity: 0.4;
      transform: scale(0.92);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .apply :global(.apply-mark) {
    position: absolute;
    right: -60px;
    top: -60px;
    opacity: 0.25;
  }
  .apply-text {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 620px;
  }
  .apply-eyebrow {
    font-size: 15px;
    line-height: 20px;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--text-2);
  }
  .apply h2 {
    font-size: clamp(30px, 4vw, 40px);
    line-height: 1.2;
  }
  .apply p {
    margin: 0;
    font-size: 17px;
    line-height: 26px;
    color: var(--color-label-2);
  }
  .apply-cta {
    position: relative;
  }
  .apply .apply-note {
    font-weight: 600;
    color: var(--text-2);
  }
</style>

<script>
  import "../scripts/count-up";
  import "../scripts/gallery";
</script>
