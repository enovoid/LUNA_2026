---
// 없는 주소. Cloudflare가 404 상태 코드와 함께 이 페이지를 돌려준다(wrangler.jsonc not_found_handling).
import Base from '../layouts/Base.astro';
---

<Base title="페이지를 찾을 수 없어요" description="요청한 페이지가 없거나 주소가 바뀌었습니다." current={null} noindex>
  <section class="nf container-page" aria-labelledby="nf-title">
    <div class="nf-moon" aria-hidden="true">
      <span class="nf-code">404</span>
    </div>
    <h1 id="nf-title">달이 길을 잃었어요</h1>
    <p>찾는 페이지가 없거나 주소가 바뀌었어요. 주소를 다시 확인하거나 아래에서 이동해 주세요.</p>
    <div class="nf-actions">
      <a href="/" class="btn btn-primary">홈으로 가기</a>
      <a href="/members" class="btn btn-bordered">멤버</a>
      <a href="/projects" class="btn btn-bordered">프로젝트</a>
      <a href="/awards" class="btn btn-bordered">수상</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding-top: 64px;
    padding-bottom: 120px;
    text-align: center;
  }
  .nf-moon {
    position: relative;
    width: 160px;
    aspect-ratio: 1;
    margin-bottom: 8px;
    border-radius: 50%;
    background: radial-gradient(circle at 36% 34%, #efeaff 0%, #907fdf 70%);
    box-shadow: 0 0 80px #907fdf55;
    display: grid;
    place-items: center;
  }
  /* 초승달 모양으로 가리는 그림자 */
  .nf-moon::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--color-bg);
    transform: translate3d(38%, -12%, 0);
  }
  .nf-code {
    position: relative;
    z-index: 1;
    transform: translate3d(-22%, 8%, 0);
    font-size: 28px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-brand-night);
  }
  h1 {
    margin: 0;
    font-size: clamp(28px, 4vw, 40px);
    line-height: 1.2;
    font-weight: 700;
  }
  p {
    max-width: 420px;
    margin: 0;
    font-size: 17px;
    line-height: 26px;
    color: var(--color-label-2);
  }
  .nf-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 8px;
  }
</style>
