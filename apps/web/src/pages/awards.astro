---
import AwardCard from '../components/AwardCard.astro';
import EmptyState from '../components/EmptyState.astro';
import Filter from '../components/Filter.astro';
import FilterBoot from '../components/FilterBoot.astro';
import PageHead from '../components/PageHead.astro';
import Base from '../layouts/Base.astro';
import { groupAwardsByYear, memberLinker, projectsForAward } from '../lib/content';
import { loadSiteData } from '../lib/data';

const { awards, members, projects } = await loadSiteData();
const groups = groupAwardsByYear(awards);
const years = groups.map((g) => g.year);
const linkMember = memberLinker(members);
---

<Base title="수상" description="루나(LUNA)의 공모전·대회 수상 기록을 연도별로 정리했습니다." current="awards">
  <PageHead title="수상">
    <Filter label="연도" param="year" options={years} unit="개" />
  </PageHead>

  <div class="container-page page-body" data-filter-scope="year">
    {
      groups.length === 0 ? (
        <EmptyState title="아직 수상 기록이 없어요" />
      ) : (
        groups.map((g) => (
          <section class="year" data-filter-group aria-labelledby={`year-${g.year}`}>
            <h2 id={`year-${g.year}`}>
              <span class="year-num">{g.year}</span>년의 루나
            </h2>
            <ul class="award-list">
              {g.awards.map((a) => (
                <li data-filter-item data-year={g.year}>
                  <AwardCard award={a} linkMember={linkMember} relatedProjects={projectsForAward(a, projects)} />
                </li>
              ))}
            </ul>
          </section>
        ))
      )
    }
    <EmptyState title="이 연도의 수상 기록이 없어요" message="다른 연도를 골라 보세요." filterEmpty />
  </div>
  <FilterBoot param="year" />
</Base>

<style>
  .page-body {
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding-top: 32px;
    padding-bottom: 96px;
  }
  .year {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  /* 예전 사이트의 "2023년의 LUNA" 머리글. 연도를 크게, 뒤 말은 한 단계 흐리게. */
  h2 {
    margin: 0;
    font-size: clamp(28px, 4vw, 40px);
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-label-2);
  }
  .year-num {
    font-weight: 800;
    color: var(--color-label);
    font-variant-numeric: tabular-nums;
  }
  .award-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
