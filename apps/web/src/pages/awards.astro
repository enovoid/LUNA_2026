---
import AwardCard from '../components/AwardCard.astro';
import EmptyState from '../components/EmptyState.astro';
import Filter from '../components/Filter.astro';
import FilterBoot from '../components/FilterBoot.astro';
import PageHead from '../components/PageHead.astro';
import Base from '../layouts/Base.astro';
import {
  computeStats,
  formatWon,
  groupAwardsByYear,
  memberLinker,
  projectsForAward,
} from '../lib/content';
import { loadSiteData } from '../lib/data';

const { awards, members, projects } = await loadSiteData();
const groups = groupAwardsByYear(awards);
const years = groups.map((g) => g.year);
const linkMember = memberLinker(members);
const { awardCount, prizeTotal } = computeStats(members, awards);
const lead =
  awardCount > 0
    ? `대회에서 거둔 성과를 연도별로 기록합니다. 지금까지 ${awardCount}번 수상했고${prizeTotal > 0 ? `, 상금은 모두 ${formatWon(prizeTotal)}입니다.` : '.'}`
    : '대회에서 거둔 성과를 연도별로 기록합니다.';
---

<Base title="수상" description="루나 멤버들이 대회에서 거둔 성과를 연도별로 기록합니다." current="awards">
  <PageHead title="수상" lead={lead}>
    <Filter label="연도" param="year" options={years} unit="개" />
  </PageHead>

  <div class="container-page page-body" data-filter-scope="year">
    {
      groups.length === 0 ? (
        <EmptyState title="아직 등록된 수상 기록이 없어요" />
      ) : (
        groups.map((g) => (
          <section class="year" data-filter-group aria-labelledby={`year-${g.year}`}>
            <h2 id={`year-${g.year}`}>{g.year}</h2>
            <ul class="award-list">
              {g.awards.map((a) => (
                <li data-filter-item data-year={g.year}>
                  <AwardCard award={a} linkMember={linkMember} relatedProjects={projectsForAward(a, projects)} />
                </li>
              ))}
            </ul>
          </section>
        ))
      )
    }
    <EmptyState title="이 연도의 수상 기록이 없어요" message="다른 연도를 골라 보세요." filterEmpty />
  </div>
  <FilterBoot param="year" />
</Base>

<style>
  .page-body {
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding-top: 32px;
    padding-bottom: 96px;
  }
  .year {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  h2 {
    margin: 0;
    font-size: 28px;
    line-height: 34px;
    font-weight: 700;
  }
  .award-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
