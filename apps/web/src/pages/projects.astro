---
import EmptyState from '../components/EmptyState.astro';
import Filter from '../components/Filter.astro';
import FilterBoot from '../components/FilterBoot.astro';
import PageHead from '../components/PageHead.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Base from '../layouts/Base.astro';
import { sortProjects, uniqueSorted } from '../lib/content';
import { loadSiteData } from '../lib/data';

const { projects } = await loadSiteData();
const sorted = sortProjects(projects);
const years = uniqueSorted(
  projects.map((p) => p.year),
  'desc',
);
---

<Base title="프로젝트" description="루나 프로젝트" current="projects">
  <PageHead title="프로젝트">
    <Filter label="연도" param="year" options={years} unit="개" />
  </PageHead>

  <div class="container-page page-body" data-filter-scope="year">
    {
      sorted.length === 0 ? (
        <EmptyState title="프로젝트가 없습니다" />
      ) : (
        <ul class="project-grid">
          {sorted.map((p) => (
            <li data-filter-item data-year={p.year}>
              <ProjectCard project={p} />
            </li>
          ))}
        </ul>
      )
    }
    <EmptyState title="프로젝트가 없습니다" filterEmpty />
  </div>
  <FilterBoot param="year" />
</Base>

<style>
  .page-body {
    padding-top: 32px;
    padding-bottom: 96px;
  }
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .project-grid > li {
    display: grid;
  }
</style>
