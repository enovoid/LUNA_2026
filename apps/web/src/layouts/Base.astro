---
import '../styles/global.css';
import { GOOGLE_SITE_VERIFICATION, NAVER_SITE_VERIFICATION } from 'astro:env/server';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import NavPerf from '../components/NavPerf.astro';
import TabBar from '../components/TabBar.astro';
import { type NavKey, nav, site } from '../content/site';
import { loadSiteData } from '../lib/data';
import { breadcrumbLd, homeLd, serializeLd } from '../lib/seo';

interface Props {
  /** 페이지 제목. 비우면 사이트 기본 제목 */
  title?: string;
  description?: string;
  current: NavKey | null;
  /** 홈: 헤더를 인트로 위에 겹친다 */
  overlayHeader?: boolean;
  noindex?: boolean;
  /** 이 페이지만의 구조화 데이터(예: FAQ). 홈 정보와 빵부스러기는 여기서 알아서 넣는다. */
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description = site.description,
  current,
  overlayHeader = false,
  noindex = false,
  jsonLd = [],
} = Astro.props;
const fullTitle = title ? `${title} | 루나 LUNA` : site.title;
// build.format: 'file'이라 빌드 때 경로가 /members.html, /index.html로 들어온다. 사이트 서버가 .html 주소를
// 확장자 없는 주소로 옮기므로(301) canonical·og:url도 실제 주소(/members, /)로 맞춘다.
const canonical = new URL(Astro.url.pathname.replace(/(\/index)?\.html$/, '') || '/', Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const { source, settings } = await loadSiteData();
const base = Astro.site ?? Astro.url;
const navItem = nav.find((n) => n.key === current);
const ld = noindex
  ? []
  : [
      ...(current === 'home' ? homeLd(base, settings.contact) : []),
      ...(navItem && current !== 'home' ? [breadcrumbLd(base, navItem.label, navItem.href)] : []),
      ...jsonLd,
    ];
---

<!doctype html>
<html lang="ko" data-theme="dark" class="theme-dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#1c1c1e" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />}
    {NAVER_SITE_VERIFICATION && <meta name="naver-site-verification" content={NAVER_SITE_VERIFICATION} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="루나 LUNA" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="어두운 배경 위의 루나 로고" />
    <meta name="twitter:card" content="summary_large_image" />
    {ld.length > 0 && <script is:inline type="application/ld+json" set:html={serializeLd(ld.length === 1 ? ld[0] : ld)} />}
    <!-- JS가 켜져 있을 때만 등장 효과·인트로 애니메이션 초기 상태를 쓴다(첫 페인트 전에 실행). -->
    <script is:inline>document.documentElement.classList.add("js");</script>
    <NavPerf />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">본문으로 건너뛰기</a>
    <Header current={current} overlay={overlayHeader} />
    <slot name="hero" />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer dataSource={source} />
    <TabBar current={current} />
    <div class="moonlight" data-moonlight aria-hidden="true"></div>
    <script>
      import "../scripts/header-bar";
      import "../scripts/moonlight";
      // iOS Safari는 문서에 touchstart 리스너가 있어야 터치 중에 :active가 걸린다(누름 반응). 스크롤은 막지 않는다.
      document.addEventListener("touchstart", () => {}, { passive: true });
    </script>
  </body>
</html>

<style is:global>
  html,
  body {
    overflow-x: clip;
  }
  #main:focus {
    outline: none;
  }

  /* 마우스 달빛(scripts/moonlight.ts). 화면 위에 얹힌 옅은 빛 한 장이라 아래 글자를 가리지 않고(가장 밝은 곳 7%)
     클릭도 통과시킨다. 헤더(30)·탭 바(40) 아래, 본문 위. */
  .moonlight {
    position: fixed;
    left: -360px;
    top: -360px;
    z-index: 20;
    width: 720px;
    height: 720px;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      rgb(255 255 255 / 0.07),
      rgb(255 255 255 / 0.03) 45%,
      transparent
    );
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
    will-change: transform;
    contain: strict;
  }
  .moonlight.is-on {
    opacity: 1;
  }
  @media not ((hover: hover) and (pointer: fine)) {
    .moonlight {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .moonlight {
      display: none;
    }
  }
  .skip-link {
    position: fixed;
    left: 12px;
    top: 12px;
    z-index: 100;
    padding: 10px 16px;
    border-radius: 1000px;
    background: var(--color-brand-violet);
    color: #fff;
    font-weight: 600;
    transform: translate3d(0, -200%, 0);
  }
  .skip-link:focus {
    transform: none;
  }
</style>
