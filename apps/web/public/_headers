# 정적 파일 응답 헤더. 사이트 서버(apps/admin/src/site.ts)가 읽어 붙이고, 파일 자체는 내보내지 않는다.
# 규칙이 없는 파일(HTML 등)은 max-age=0, must-revalidate + ETag: 다시 빌드하면 바로 새 내용이 보인다.
# 한 경로에 여러 규칙이 맞으면 뒤의 규칙이 이긴다. Cache-Control은 경로마다 한 번만 쓴다.

# 파일 이름에 내용 해시가 붙은 빌드 산출물(JS·CSS·폰트·SVG): 1년, 다시 묻지 않음
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# DB에서 꺼낸 사진: 파일 이름에 원본 해시가 들어 있어 내용이 바뀌지 않는다
/img/*
  Cache-Control: public, max-age=31536000, immutable

# 인트로 사진: 이름에 해시가 없어 1주 캐시 + 하루 동안은 낡은 것을 보여 주며 뒤에서 갱신
/intro/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/favicon.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/favicon.ico
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/icon-512.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/og.png
  Cache-Control: public, max-age=86400

# 서비스 워커는 항상 새로 확인해야 수정이 바로 퍼진다
/sw.js
  Cache-Control: no-cache
