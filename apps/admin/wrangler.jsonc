{
  // LUNA 관리자 Worker. 공개 사이트(apps/web)와 따로 배포하고, Cloudflare Access로 운영진만 들어오게 한다.
  // 설정 순서는 apps/admin/README.md 참고.
  "name": "luna-admin",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // postgres 드라이버가 TCP 소켓·Buffer 등 Node 호환 API를 쓴다.
  "compatibility_flags": ["nodejs_compat"],
  // workers.dev 주소에는 Worker 설정에서 Cloudflare Access를 켠다(README). 미리보기 주소는 쓰지 않는다.
  "workers_dev": true,
  "preview_urls": false,
  // 사이트 도메인을 정하면 같은 도메인의 /admin 아래로 붙인다(README "도메인에 붙이기").
  // "routes": [{ "pattern": "luna.example.com/admin*", "zone_name": "luna.example.com" }],
  "vars": {
    "GITHUB_REPOSITORY": "enovoid/LUNA_2026"
  },
  // ACCESS_TEAM_DOMAIN, ACCESS_AUD, SITE_URL은 대시보드(Worker → Settings → Variables and Secrets)에서 넣는다.
  // keep_vars가 있어야 배포할 때 대시보드에서 넣은 값이 지워지지 않는다.
  "keep_vars": true,
  // 비밀 값(DATABASE_URL, GITHUB_TOKEN)도 같은 곳에서 Secret으로 넣는다.
  "observability": { "enabled": true }
}
