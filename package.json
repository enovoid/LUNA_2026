{
  "name": "luna-2026",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26",
      "onFail": "error"
    }
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm --filter ./apps/web build",
    "dev": "pnpm --filter ./apps/web dev",
    "start": "pnpm --filter @luna/admin start",
    "db:generate": "pnpm --filter @luna/db generate",
    "db:migrate": "pnpm --filter @luna/db migrate",
    "sync": "pnpm --filter @luna/sync sync",
    "import:notion": "pnpm --filter @luna/sync import:notion"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^26.6.6",
    "typescript": "~6.0.3"
  }
}
