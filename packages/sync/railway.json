{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @luna/sync typecheck",
    "watchPatterns": [
      "packages/sync/**",
      "packages/db/**",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml"
    ]
  },
  "deploy": {
    "startCommand": "pnpm --filter @luna/sync start",
    "cronSchedule": "*/15 * * * *",
    "restartPolicyType": "NEVER"
  }
}
