    "test": "vitest run"
  },
  "dependencies": {
    "@luna/db": "workspace:*",
    "@notionhq/client": "^5.30.0",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "p-queue": "^10.0.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "vitest": "^5.0.5"
  }
}
